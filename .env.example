DOMAIN=mc.example.com
LETSENCRYPT_EMAIL=admin@example.com
# Set this to the absolute path of this repo's servers directory.
MCUI_SERVERS_DIR=/absolute/path/to/mcui/servers

# Google Drive backup: configure ./backup/rclone.conf and ./backup/restic-password.
MCUI_BACKUP_REMOTE=drive
MCUI_BACKUP_PATH=mcui
MCUI_BACKUP_INTERVAL=24h
