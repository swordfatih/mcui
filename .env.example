DOMAIN=mc.example.com
LETSENCRYPT_EMAIL=admin@example.com
# Set this to the absolute path of this repo's servers directory.
MCUI_SERVERS_DIR=/absolute/path/to/mcui/servers
MCUI_HTTP_PASSWORD=replace-with-a-long-random-password

# Google Drive backup: configure ./backup/rclone.conf.
MCUI_BACKUP_REMOTE=drive
MCUI_BACKUP_PATH=mcui
MCUI_BACKUP_INTERVAL=24h

# Optional Web Push contact. Compose defaults to mailto:LETSENCRYPT_EMAIL.
# VAPID keys and subscriptions are generated in servers/.mcui-push/.
MCUI_PUSH_CONTACT=mailto:admin@example.com
